printimpact.com.au {
  encode zstd gzip

  reverse_proxy web:3000 {
    # active health checks
    health_uri /               # or /health if you have one
    health_interval 10s
    health_timeout 2s

    # selection retries for older Caddy
    lb_try_duration 30s        # was: try_duration
    fail_duration 5s           # passive health-check memory

    # good practice with lb_try_*: keep dial timeout < try duration
    transport http {
      dial_timeout 2s
    }
  }
}
